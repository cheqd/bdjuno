###############################################################
###        STAGE 1: Build Hasura CLI pre-requisites        	###
###############################################################

FROM ubuntu:jammy

# Upgrade base packages (incl. OpenSSL security fixes) and install curl
RUN apt update && apt upgrade -y && apt install -y curl \
    && rm -rf /var/lib/apt/lists/*
SHELL ["/bin/bash", "-euo", "pipefail", "-c"]

# Pin Hasura CLI version (get.sh otherwise defaults to an outdated hardcoded version)
ARG HASURA_VERSION="v2.51.3"

# Get Hasura CLI and install
RUN curl -L https://github.com/hasura/graphql-engine/raw/stable/cli/get.sh | VERSION=${HASURA_VERSION} bash

# Set user directory and details
ARG HOME_DIR="/hasura"
ARG USER="hasura"

# Add non-root user to use in the container
RUN addgroup --system $USER \
    && adduser $USER --system --home $HOME_DIR --shell /bin/bash

# Set working directory & bash defaults
WORKDIR $HOME_DIR
USER $USER

# Copy chain-specific config file from Git repo
COPY --chown=$USER:$USER hasura/ .
RUN chmod +x entrypoint.sh

ENTRYPOINT [ "/hasura/entrypoint.sh" ]
